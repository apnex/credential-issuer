{
  "name": "@apnex/credential-issuer",
  "version": "0.1.0",
  "private": true,
  "description": "Issue the credentials a caller presents to reach a hub, from authority the host accepts.",
  "license": "MIT",
  "author": "apnex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apnex/credential-issuer.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./machine": {
      "types": "./dist/machine.d.ts",
      "default": "./dist/machine.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "docs:check": "tools/check-docs.sh"
  },
  "devDependencies": {
    "@agp/core": "file:../agp/packages/core",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@agp/core": "file:../agp/packages/core"
  },
  "peerDependenciesMeta": {
    "@agp/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@apnex/caller-identity": "https://github.com/apnex/caller-identity/releases/download/v0.1.0/apnex-caller-identity-0.1.0.tgz",
    "@apnex/shape-check": "https://github.com/apnex/shape-check/releases/download/v0.1.0/apnex-shape-check-0.1.0.tgz"
  },
  "overrides": {
    "@apnex/caller-identity": {
      "@agp/core": "$@agp/core"
    }
  }
}
